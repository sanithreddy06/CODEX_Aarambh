# CODEX Environment Configuration
APP_NAME=CODEX
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./codex.db

# Storage Directories
STORAGE_DIR=./data/storage
PROJECTS_DIR=./data/projects
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration (Optional - Core engine functions deterministically without keys)
AI_PROVIDER=gemini # options: gemini, groq, openai, local, deterministic
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LOCAL_MODEL_URL=http://localhost:11434/v1
